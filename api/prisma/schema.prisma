generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContextType {
  OPERACION
  SIMULACION
}

enum Role {
  ADMIN_PILOTO
  DR
  EQUIPO_REGIONAL
  NIVEL_CENTRAL_SIM
}

enum RegionScopeMode {
  ALL
  LIST
}

enum CaseStatus {
  OPEN
  CLOSED
}

enum CriticalityLevel {
  LEVEL_1
  LEVEL_2
  LEVEL_3
  LEVEL_4
}

enum EventType {
  CASE_CREATED
  COMMENT_ADDED
  INSTRUCTION_CREATED
  CASE_CLOSED
  ACK
  RESOLVE
  CHANGE_CRITICALITY
  OPERATIONAL_VALIDATION
  ASSIGNMENT_CHANGED
  ACTION_ADDED
  DECISION_ADDED
}

model Region {
  id          String       @id
  name        String
  createdAt   DateTime     @default(now())

  Province    Province[]
  simulations Simulation[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  memberships  Membership[]
}

model Membership {
  id              String          @id @default(cuid())
  userId          String
  contextType     ContextType
  contextId       String
  role            Role
  createdAt       DateTime        @default(now())
  regionCode      String
  regionScopeMode RegionScopeMode @default(LIST)
  regionScope     String[]        @default([])

  user            User            @relation(fields: [userId], references: [id])

  @@unique([userId, contextType, contextId, regionCode], map: "Membership_user_context_region_unique")
  @@index([contextType, contextId])
  @@index([userId])
  @@index([regionCode])
}

model Simulation {
  id           String   @id @default(cuid())
  regionId     String
  name         String
  electionYear Int
  isActive     Boolean  @default(true)
  createdBy    String
  createdAt    DateTime @default(now())

  region       Region   @relation(fields: [regionId], references: [id])

  @@index([regionId])
}

model Case {
  id               String           @id @default(cuid())
  contextType      ContextType
  contextId        String
  summary          String
  criticality      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  regionCode       String           @default("")
  communeCode      String           @default("")
  localCode        String           @default("")
  localSnapshot    Json?

  title            String
  description      String?
  createdByUserId  String
  criticalityLevel CriticalityLevel
  status           CaseStatus
  assignedTo       String?

  detail           String?
  evaluation       Json?
  completeness     Int?
  actions          Json?
  decisions        Json?
  instructions     Json?

  Event            Event[]

  @@index([contextType, contextId])
  @@index([regionCode, communeCode])
}

model Event {
  id          String      @id @default(cuid())
  caseId      String
  contextType ContextType
  contextId   String
  actorId     String
  eventType   EventType
  payloadJson Json
  prevHash    String?
  hash        String
  createdAt   DateTime    @default(now())

  Case        Case        @relation(fields: [caseId], references: [id])

  @@index([caseId])
  @@index([contextType, contextId])
}

model Commune {
  id         String   @id
  provinceId String
  name       String
  isActive   Boolean  @default(true)
  source     String
  updatedAt  DateTime
  createdAt  DateTime @default(now())

  Province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  @@index([provinceId])
}

model Province {
  id        String    @id
  regionId  String
  name      String
  createdAt DateTime  @default(now())

  Commune   Commune[]
  Region    Region    @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@index([regionId])
}
